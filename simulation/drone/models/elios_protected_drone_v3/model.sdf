      <sensor name="air_pressure_sensor" type="air_pressure">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure><noise type="gaussian"><mean>0</mean><stddev>3</stddev></noise></pressure>
        </air_pressure>
      </sensor>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <x><noise type="gaussian"><stddev>0.0001</stddev></noise></x>
          <y><noise type="gaussian"><stddev>0.0001</stddev></noise></y>
          <z><noise type="gaussian"><stddev>0.0001</stddev></noise></z>
        </magnetometer>
      </sensor>
      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.0008726646</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.0008726646</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.0008726646</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.00637</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.00637</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.00686</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>

      <sensor name="navsat_sensor" type="navsat">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>

    </link>

    <!-- ELIOS-SAR 3D LiDAR -->
    <link name="lidar_link">
      <pose>0 0 -0.035 0 0 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <velocity_decay />

      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000001</iyy>
          <iyz>0</iyz>
          <izz>0.000001</izz>
        </inertia>
      </inertial>

      <!-- Small visual representation of the LiDAR -->
      <visual name="lidar_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.018</radius>
            <length>0.025</length>
          </cylinder>
        </geometry>
      </visual>

      <sensor name="lidar_3d" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <update_rate>10</update_rate>
        <topic>/drone/lidar/points</topic>

        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>

            <vertical>
              <samples>32</samples>
              <resolution>1</resolution>
              <min_angle>-0.523599</min_angle>
              <max_angle>0.523599</max_angle>
            </vertical>
          </scan>

          <range>
            <min>0.10</min>
            <max>30.0</max>
            <resolution>0.01</resolution>
          </range>

          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>

        <gz_frame_id>lidar_link</gz_frame_id>
      </sensor>
    </link>

    <!-- LiDAR fixed to the drone body -->
    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>

    <link name="rotor_0">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay />
      <pose>0.090 -0.090 0.055 0 0 0</pose>
      <inertial>
        <mass>0.012</mass>
        <inertia><ixx>2.0e-7</ixx><iyy>2.0e-7</iyy><izz>3.0e-7</izz></inertia>
      </inertial>
      <visual name="motor_hub_accent">
        <pose>0 0 -0.019 0 0 0</pose>
        <geometry><cylinder><radius>0.0048</radius><length>0.004</length></cylinder></geometry>
        <material><ambient>0.10 0.025 0.005 1</ambient><diffuse>0.90 0.18 0.02 1</diffuse><specular>0.45 0.20 0.08 1</specular></material>
      </visual>
      <visual name="motor_bell">
        <pose>0 0 -0.025 0 0 0</pose>
        <geometry><cylinder><radius>0.009</radius><length>0.012</length></cylinder></geometry>
        <material><ambient>0.025 0.025 0.028 1</ambient><diffuse>0.060 0.065 0.070 1</diffuse><specular>0.35 0.35 0.35 1</specular></material>
      </visual>
      <visual name="prop_blade_a">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.127 0.007 0.0015</size></box></geometry>
        <material><ambient>0.035 0.040 0.045 0.85</ambient><diffuse>0.10 0.12 0.14 0.85</diffuse><specular>0.20 0.20 0.20 1</specular></material>
      </visual>
      <visual name="prop_blade_b">
        <pose>0 0 0 0 0 1.570796</pose>
        <geometry><box><size>0.127 0.007 0.0015</size></box></geometry>
        <material><ambient>0.035 0.040 0.045 0.85</ambient><diffuse>0.10 0.12 0.14 0.85</diffuse><specular>0.20 0.20 0.20 1</specular></material>
      </visual>
      <collision name="prop_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.127 0.007 0.0015</size></box></geometry>
      </collision>
    </link>
    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent><child>rotor_0</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics>
      </axis>
    </joint>


    <link name="rotor_1">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay />
      <pose>-0.090 0.090 0.055 0 0 0</pose>
