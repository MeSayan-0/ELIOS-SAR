      </axis>
    </joint>


    <link name="rotor_2">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay />
      <pose>0.090 0.090 0.055 0 0 0</pose>
      <inertial>
        <mass>0.012</mass>
