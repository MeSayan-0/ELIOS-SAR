<?xml version="1.0"?>
<sdf version="1.9">

  <model name="ellios_rover">

    <!-- =========================================================
         ELLIOS MINE-SAR 4-WHEEL UGV
         
         Coordinate system:
           +X = forward
           +Y = left
           +Z = up

         Wheel axle:
           Y axis

         Wheel rolling direction:
           X axis
         ========================================================= -->

    <!-- Rover starts inside the mine -->
    <pose>2.0 0.0 0.32 0 0 0</pose>


    <!-- =========================================================
         MAIN CHASSIS
         ========================================================= -->

    <link name="base_link">

      <pose>0 0 0 0 0 0</pose>

      <inertial>
        <mass>30.0</mass>

        <inertia>
          <!-- 30 kg rectangular body:
               length = 1.40 m
               width  = 0.90 m
               height = 0.32 m -->
          <ixx>2.2810</ixx>
          <iyy>5.1565</iyy>
          <izz>6.9250</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <!-- Chassis visual -->
      <visual name="chassis_visual">
        <pose>0 0 0 0 0 0</pose>

        <geometry>
          <box>
            <size>1.40 0.90 0.32</size>
          </box>
        </geometry>

        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.25 0.25 0.25 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>

      <!-- Chassis collision -->    
      <collision name="chassis_collision">
        <pose>0 0 0 0 0 0</pose>

        <geometry>
          <box>
            <size>1.40 0.90 0.32</size>
          </box>
        </geometry>
      </collision>


      <!-- =====================================================
           2D GPU LIDAR
           
           Mounted on top of rover.
           
           Rover coordinate system:
             +X = forward
             +Y = left
             +Z = up
           
           LiDAR height:
             0.30 m above rover model origin
           
           Scan:
             360 degrees
             720 samples
             10 Hz
             20 m maximum range
           
           Output:
             /rover/scan
           ===================================================== -->

      <visual name="lidar_visual">
        <pose>0 0 0.30 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
          <specular>0.30 0.30 0.30 1</specular>
        </material>
      </visual>


      <!-- =====================================================
           GPU 2D LIDAR SENSOR
           ===================================================== -->

      <sensor name="lidar_2d" type="gpu_lidar">

        <pose>0 0 0.30 0 0 0</pose>

        <always_on>true</always_on>

        <update_rate>10</update_rate>

        <visualize>true</visualize>

        <topic>/rover/scan</topic>

        <lidar>

          <scan>

            <horizontal>

              <samples>720</samples>

              <resolution>1</resolution>

              <min_angle>-3.14159265</min_angle>

              <max_angle>3.14159265</max_angle>

            </horizontal>

          </scan>

          <range>

            <min>0.12</min>

            <max>20.0</max>

            <resolution>0.01</resolution>

          </range>

        </lidar>

      </sensor>
    </link>


    <!-- =========================================================
         FRONT LEFT WHEEL
         
         Position:
           X = +0.48
           Y = +0.51
           Z = 0

         Cylinder native axis = Z.
         Rotate +90 degrees around X so cylinder axis becomes Y.
         ========================================================= -->

    <link name="front_left_wheel">

      <pose>0.48 0.51 0 1.57079632679 0 0</pose>

      <inertial>
        <mass>2.5</mass>

        <inertia>
          <ixx>0.06387</ixx>
          <iyy>0.06050</iyy>
          <izz>0.06387</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <visual name="front_left_wheel_visual">

        <!-- Cylinder axis is Z by default -->
        <geometry>
          <cylinder>
            <radius>0.22</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>

      </visual>

      <collision name="front_left_wheel_collision">

        <geometry>
          <cylinder>
            <radius>0.22</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>1.5</mu>
              <mu2>1.5</mu2>
            </ode>
          </friction>
        </surface>

      </collision>

    </link>


    <!-- =========================================================
         REAR LEFT WHEEL
         ========================================================= -->

    <link name="rear_left_wheel">

      <pose>-0.48 0.51 0 1.57079632679 0 0</pose>

      <inertial>
        <mass>2.5</mass>

        <inertia>
          <ixx>0.06387</ixx>
          <iyy>0.06050</iyy>
          <izz>0.06387</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <visual name="rear_left_wheel_visual">

        <geometry>
          <cylinder>
            <radius>0.22</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>

      </visual>

      <collision name="rear_left_wheel_collision">

        <geometry>
          <cylinder>
            <radius>0.22</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>1.5</mu>
              <mu2>1.5</mu2>
            </ode>
          </friction>
        </surface>

      </collision>

    </link>


    <!-- =========================================================
         FRONT RIGHT WHEEL
         ========================================================= -->

    <link name="front_right_wheel">

      <pose>0.48 -0.51 0 1.57079632679 0 0</pose>

      <inertial>
        <mass>2.5</mass>

        <inertia>
          <ixx>0.06387</ixx>
          <iyy>0.06050</iyy>
          <izz>0.06387</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <visual name="front_right_wheel_visual">

        <geometry>
          <cylinder>
            <radius>0.22</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>

      </visual>

      <collision name="front_right_wheel_collision">

        <geometry>
          <cylinder>
            <radius>0.22</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>1.5</mu>
              <mu2>1.5</mu2>
            </ode>
          </friction>
        </surface>

      </collision>

    </link>


    <!-- =========================================================
         REAR RIGHT WHEEL
         ========================================================= -->

    <link name="rear_right_wheel">

      <pose>-0.48 -0.51 0 1.57079632679 0 0</pose>

      <inertial>
        <mass>2.5</mass>

        <inertia>
          <ixx>0.06387</ixx>
          <iyy>0.06050</iyy>
          <izz>0.06387</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <visual name="rear_right_wheel_visual">

        <geometry>
          <cylinder>
            <radius>0.22</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>

      </visual>

      <collision name="rear_right_wheel_collision">

        <geometry>
          <cylinder>
            <radius>0.22</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>1.5</mu>
              <mu2>1.5</mu2>
            </ode>
          </friction>
        </surface>

      </collision>

    </link>


    <!-- =========================================================
         FRONT LEFT WHEEL JOINT
         ========================================================= -->

    <joint name="front_left_wheel_joint"
           type="revolute">

      <parent>base_link</parent>
      <child>front_left_wheel</child>

      <axis>
        <!-- expressed_in="__model__" is REQUIRED here.
             Without it, this axis is read in the wheel's own
             rotated child frame (90 deg about X), which makes
             "0 1 0" silently resolve to the world Z axis -->
        <xyz expressed_in="__model__">0 1 0</xyz>

        <dynamics>
          <damping>0.15</damping>
          <friction>0.02</friction>
        </dynamics>

        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>-1</effort>
          <velocity>-1</velocity>
        </limit>

      </axis>

    </joint>


    <!-- =========================================================
         REAR LEFT WHEEL JOINT
         ========================================================= -->

    <joint name="rear_left_wheel_joint"
           type="revolute">

      <parent>base_link</parent>
      <child>rear_left_wheel</child>

      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>

        <dynamics>
          <damping>0.15</damping>
          <friction>0.02</friction>
        </dynamics>

        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>-1</effort>
          <velocity>-1</velocity>
        </limit>

      </axis>

    </joint>


    <!-- =========================================================
         FRONT RIGHT WHEEL JOINT
         ========================================================= -->

    <joint name="front_right_wheel_joint"
           type="revolute">

      <parent>base_link</parent>
      <child>front_right_wheel</child>

      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>

        <dynamics>
          <damping>0.15</damping>
          <friction>0.02</friction>
        </dynamics>

        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>-1</effort>
          <velocity>-1</velocity>
        </limit>

      </axis>

    </joint>


    <!-- =========================================================
         REAR RIGHT WHEEL JOINT
         ========================================================= -->

    <joint name="rear_right_wheel_joint"
           type="revolute">

      <parent>base_link</parent>
      <child>rear_right_wheel</child>

      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>

        <dynamics>
          <damping>0.15</damping>
          <friction>0.02</friction>
        </dynamics>

        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>-1</effort>
          <velocity>-1</velocity>
        </limit>

      </axis>

    </joint>


    <!-- =========================================================
         4-WHEEL SKID-STEER DIFFERENTIAL DRIVE
         ========================================================= -->

    <plugin
      filename="libgz-sim-diff-drive-system.so"
      name="gz::sim::systems::DiffDrive">

      <!-- LEFT SIDE -->
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>

      <!-- RIGHT SIDE -->
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>

      <!-- Wheel geometry -->
      <wheel_separation>1.02</wheel_separation>
      <wheel_radius>0.22</wheel_radius>

      <!-- ROS/Gazebo command interface -->
      <topic>/rover/cmd_vel</topic>

      <!-- Odometry -->
      <odom_topic>/rover/odom</odom_topic>
      <tf_topic>/tf</tf_topic>

      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>

      <odom_publish_frequency>30</odom_publish_frequency>

      <!-- Motion limits.
           NOTE: gz-sim-diff-drive-system does NOT have
           min_linear_acceleration / min_angular_acceleration
           parameters - those tags are silently ignored by the
           plugin. The correct tags for deceleration limits are
           max_linear_deceleration / max_angular_deceleration. -->
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_linear_deceleration>1.0</max_linear_deceleration>

      <max_angular_acceleration>1.5</max_angular_acceleration>
      <max_angular_deceleration>1.5</max_angular_deceleration>

    </plugin>

  </model>

</sdf>
